# Publishing secrets for Clocked In.
#
# Copy this file to `.env` and fill in the values. `.env` and `.secrets/` are
# git-ignored. Real environment variables with the same names take priority (use
# those in CI). Run `./gradlew checkPublishingSecrets` to see what's set.

# Required for `./gradlew publishPlugin`.
# Create it at https://plugins.jetbrains.com -> your profile -> My Tokens.
PUBLISH_TOKEN=

# Optional: sign the plugin. JetBrains Marketplace also signs plugins itself.
# Paths are relative to the project root. See docs/DEVELOPMENT.md for how to
# create the key and certificate. Suggested values once they exist:
#   CERTIFICATE_CHAIN_FILE=.secrets/chain.crt
#   PRIVATE_KEY_FILE=.secrets/private_encrypted.pem
CERTIFICATE_CHAIN_FILE=
PRIVATE_KEY_FILE=
# Only needed if the private key is encrypted.
PRIVATE_KEY_PASSWORD=

# For CI you can pass the PEM contents instead of files:
# CERTIFICATE_CHAIN=
# PRIVATE_KEY=
